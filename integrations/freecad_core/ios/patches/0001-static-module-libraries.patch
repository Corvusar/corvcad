 project(FreeCAD)
+
+option(FREECAD_STATIC_MODULES "Experimental static headless Python modules" OFF)
+if(FREECAD_STATIC_MODULES)
+    if(NOT APPLE OR BUILD_GUI)
+        message(FATAL_ERROR "The static investigation profile requires headless Apple targets")
+    endif()
+    set(FREECAD_MODULE_LIBRARY_TYPE STATIC)
+else()
+    set(FREECAD_MODULE_LIBRARY_TYPE SHARED)
+endif()
 
