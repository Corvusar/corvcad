+        message(FATAL_ERROR "Static profile requires CORVCAD_STATIC_REGISTRY")
+    endif()
+    target_sources(FreeCADMainCmd PRIVATE "${CORVCAD_STATIC_REGISTRY}")
+    target_compile_definitions(FreeCADMainCmd PRIVATE CORVCAD_FREECAD_STATIC)
+    foreach(module FreeCADBase FreeCADApp Materials Part Mesh Sketcher PartDesign Spreadsheet Import)
+        target_link_libraries(FreeCADMainCmd ${module})
