+
+# OCCT exports HAVE_TBB globally. ImportOCAF then calls TBB directly, so a
+# static Import archive must carry that dependency to its final executable.
+if(FREECAD_STATIC_MODULES AND OpenCASCADE_WITH_TBB)
+    find_package(TBB CONFIG REQUIRED COMPONENTS tbb)
