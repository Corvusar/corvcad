--- a/src/Base/Interpreter.cpp
+++ b/src/Base/Interpreter.cpp
@@ -24,6 +24,8 @@
  ***************************************************************************/
 
 #include <sstream>
+#include <cstdlib>
+#include <cstring>
 #include <boost/regex.hpp>
 
 #include <FCConfig.h>
@@ -611,6 +613,65 @@
 #else
 namespace
 {
+#ifdef FC_OS_IOS
+// The iOS embedding profile executes geometry in this process. Fail explicitly
+// if a helper tries to launch another executable, including through os wrappers.
+int denyIOSProcessCreation(const char* event, PyObject*, void*)
+{
+    static const char* denied[] = {"subprocess.Popen", "os.system", "os.fork",
+        "os.forkpty", "os.posix_spawn", "os.exec", "os.spawn"};
+    for (const char* name : denied) {
+        if (std::strcmp(event, name) == 0) {
+            PyErr_SetString(PyExc_RuntimeError, "Process creation is unavailable in CorvCAD iOS");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+void initInterpreter(int argc, char* argv[])
+{
+    // The embedding harness supplies its reviewed, read-only runtime directory.
+    // This is deliberately independent of Python environment/path discovery.
+    const char* stdlib = std::getenv("CORVCAD_PYTHON_STDLIB");
+    if (!stdlib || stdlib[0] != '/') {
+        throw Base::RuntimeError("CORVCAD_PYTHON_STDLIB must be an absolute bundled path");
+    }
+    if (PySys_AddAuditHook(denyIOSProcessCreation, nullptr) < 0) {
+        throw Base::RuntimeError("Failed to install the iOS process audit hook");
+    }
+    PyConfig config;
+    PyConfig_InitIsolatedConfig(&config);
+    config.isolated = 1;
+    config.use_environment = 0;
+    config.user_site_directory = 0;
+    config.site_import = 0;
+    config.write_bytecode = 0;
+    config.install_signal_handlers = 0;
+    config.safe_path = 1;
+    config.module_search_paths_set = 1;
+    PyStatus status = PyConfig_SetBytesArgv(&config, argc, argv);
+    if (!PyStatus_Exception(status)) {
+        status = PyConfig_SetBytesString(&config, &config.stdlib_dir, stdlib);
+    }
+    wchar_t* path = Py_DecodeLocale(stdlib, nullptr);
+    if (!path) {
+        PyConfig_Clear(&config);
+        throw Base::RuntimeError("Failed to decode bundled iOS Python path");
+    }
+    if (!PyStatus_Exception(status)) {
+        status = PyWideStringList_Append(&config.module_search_paths, path);
+    }
+    PyMem_RawFree(path);
+    if (!PyStatus_Exception(status)) {
+        status = Py_InitializeFromConfig(&config);
+    }
+    PyConfig_Clear(&config);
+    if (PyStatus_Exception(status)) {
+        throw Base::RuntimeError("Failed to initialize isolated iOS Python");
+    }
+}
+#else
 void initInterpreter(int argc, char* argv[])
 {
     PyStatus status;
@@ -646,6 +707,7 @@
 
     Py_Initialize();
 }
+#endif  // FC_OS_IOS
 }  // namespace
