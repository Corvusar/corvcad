--- a/src/Main/CMakeLists.txt
+++ b/src/Main/CMakeLists.txt
@@ -58,6 +58,12 @@
 )
 
 add_executable(FreeCADMainCmd ${FreeCADMainCmd_SRCS})
+
+if(FREECAD_STATIC_MODULES AND CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # Headless harness owns main(); Qt 6.11 uses this lowercase property to
+    # avoid the UIKit platform-plugin entry point inherited through QtCore.
+    set_property(TARGET FreeCADMainCmd PROPERTY qt_no_entrypoint TRUE)
+endif()
 
 SET(FreeCADMainCmd_LIBS
     FreeCADApp
@@ -109,6 +115,40 @@
         # Keep registration objects and Qt resources in static archives alive.
         target_link_options(FreeCADMainCmd PRIVATE "LINKER:-force_load,$<TARGET_FILE:${module}>")
     endforeach()
+    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        # Share the reviewed vcpkg archives with FreeCAD rather than linking a
+        # second SDK implementation. Zlib already propagates from FreeCADBase.
+        foreach(archive CORVCAD_IOS_FFI_LIBRARY CORVCAD_IOS_BZIP2_LIBRARY)
+            if(NOT IS_ABSOLUTE "${${archive}}" OR NOT EXISTS "${${archive}}")
+                message(FATAL_ERROR "Explicit static iOS dependency required: ${archive}")
+            endif()
+        endforeach()
+        target_link_libraries(FreeCADMainCmd
+            "${CORVCAD_IOS_FFI_LIBRARY}" "${CORVCAD_IOS_BZIP2_LIBRARY}"
+            sqlite3 iconv objc "-framework Foundation" "-framework UIKit")
+        # OCCT's exported static targets do not carry the full toolkit closure.
+        # Require the measured closure explicitly before adding its archives.
+        if(NOT CORVCAD_IOS_OCCT_LIBRARIES)
+            message(FATAL_ERROR "Explicit measured iOS OCCT toolkit closure required")
+        endif()
+        set(_corvcad_occt_actual "${OpenCASCADE_LIBRARIES}")
+        set(_corvcad_occt_expected "${CORVCAD_IOS_OCCT_LIBRARIES}")
+        list(SORT _corvcad_occt_actual)
+        list(SORT _corvcad_occt_expected)
+        if(NOT _corvcad_occt_actual STREQUAL _corvcad_occt_expected)
+            message(FATAL_ERROR "OCCT exports differ from the measured iOS toolkit closure")
+        endif()
+        foreach(toolkit IN LISTS OpenCASCADE_LIBRARIES)
+            if(NOT TARGET "${toolkit}")
+                message(FATAL_ERROR "Missing static iOS OCCT toolkit target: ${toolkit}")
+            endif()
+            get_target_property(_corvcad_occt_type "${toolkit}" TYPE)
+            if(NOT _corvcad_occt_type STREQUAL "STATIC_LIBRARY")
+                message(FATAL_ERROR "Non-static iOS OCCT toolkit target: ${toolkit}")
+            endif()
+        endforeach()
+        target_link_libraries(FreeCADMainCmd ${OpenCASCADE_LIBRARIES})
+    endif()
 endif()
 
 if(NOT FREECAD_STATIC_MODULES)
