diff --git a/cMake/FreeCAD_Helpers/SetupPython.cmake b/cMake/FreeCAD_Helpers/SetupPython.cmake
--- a/cMake/FreeCAD_Helpers/SetupPython.cmake
+++ b/cMake/FreeCAD_Helpers/SetupPython.cmake
@@ -1,7 +1,37 @@
 macro(SetupPython)
 # -------------------------------- Python --------------------------------
 
-    find_package(Python3 COMPONENTS Interpreter Development REQUIRED)
+    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        if(NOT FREECAD_STATIC_MODULES)
+            message(FATAL_ERROR "The CorvCAD iOS profile requires static modules")
+        endif()
+        # The executable runs on macOS for generators. Only headers/archive are
+        # target artifacts; never require an emulator to execute target Python.
+        foreach(artifact Python3_EXECUTABLE Python3_INCLUDE_DIR Python3_LIBRARY)
+            if(NOT IS_ABSOLUTE "${${artifact}}" OR NOT EXISTS "${${artifact}}")
+                message(FATAL_ERROR "Explicit iOS Python artifact required: ${artifact}")
+            endif()
+        endforeach()
+        set(_corvcad_host_python "${Python3_EXECUTABLE}")
+        execute_process(COMMAND "${_corvcad_host_python}" -c
+            "import sys; print('.'.join(map(str, sys.version_info[:3])))"
+            RESULT_VARIABLE _corvcad_host_status OUTPUT_VARIABLE _corvcad_host_version
+            OUTPUT_STRIP_TRAILING_WHITESPACE)
+        if(NOT _corvcad_host_status EQUAL 0 OR NOT _corvcad_host_version STREQUAL "3.13.7")
+            message(FATAL_ERROR "The iOS generators require host CPython 3.13.7")
+        endif()
+        # Hide the host executable from target development discovery, including
+        # CMake 4.1+ with CMP0190 NEW. It is restored for all generator commands.
+        set(Python3_EXECUTABLE "")
+        find_package(Python3 3.13.7 EXACT COMPONENTS Development.Embed REQUIRED)
+        if(NOT Python3_VERSION STREQUAL _corvcad_host_version)
+            message(FATAL_ERROR "Host and target CPython versions differ")
+        endif()
+        set(Python3_EXECUTABLE "${_corvcad_host_python}")
+        set(Python3_Interpreter_FOUND TRUE)
+    else()
+        find_package(Python3 COMPONENTS Interpreter Development REQUIRED)
+    endif()
 
     if (${Python3_VERSION} VERSION_LESS "3.10")
          message(FATAL_ERROR "To build FreeCAD you need at least Python 3.10\n")
