  "source_policy": {
    "eigen": "Use FreeCAD Eigen3.4.0#5 override for all union header consumers. KiCad selected iOS prefix has no Eigen package.",
    "fmt": "Blocked for combined acceptance until KiCad vendored fmt12.1.0 and FreeCAD vcpkg fmt12.2.0 headers/compiled symbols are unified and inventoried.",
    "wx_codecs": "Existing KiCad profiles include bundled wxzlib/wxpng and vcpkg zlib/libpng. A union manifest does not establish unique strong symbols; inspect actual combined link map.",
    "inventory": "Candidate dependency provenance only. KiCad measured compiler/linker inventory refresh and combined tests are required before native acceptance.",
    "cache": "Each SDK owns its installed prefix. Reuse only vcpkg ABI-verified binary-cache entries; do not copy archives from accepted SDK prefixes.",
    "host_headers": "Host triplet overlays set CMAKE_NO_SYSTEM_FROM_IMPORTED=ON for CMake ports, preserving imported vcpkg dependency include precedence over compiler-injected Homebrew paths. Target iOS triplets are unchanged."
  },
