+void PNS_KICAD_IFACE::EraseView()
+{
+    for( BOARD_ITEM* item : m_hiddenItems )
+        m_view->SetVisible( item, true );
+
+    m_hiddenItems.clear();
+
+    if( m_previewItems )
+    {
+        m_previewItems->FreeItems();
+        m_view->Update( m_previewItems );
+    }
+
+    if( m_debugDecorator )
+        m_debugDecorator->Clear();
+}
