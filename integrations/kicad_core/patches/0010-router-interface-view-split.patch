+int PNS_KICAD_IFACE::GetNetCode( PNS::NET_HANDLE aNet ) const
+{
+    if( aNet )
+        return static_cast<NETINFO_ITEM*>( aNet )->GetNetCode();
+    else
+        return -1;
+}
