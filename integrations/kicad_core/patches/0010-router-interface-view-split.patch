+bool PNS_KICAD_IFACE::IsAnyLayerVisible( const PNS_LAYER_RANGE& aLayer ) const
+{
+    if( !m_view )
+        return false;
+
+    for( int i = aLayer.Start(); i <= aLayer.End(); i++ )
+    {
+        if( m_view->IsLayerVisible( GetBoardLayerFromPNSLayer( i ) ) )
+            return true;
+    }
+
+    return false;
+}
