+// The board editor's part of BOARD_NETLIST_UPDATER, moved unchanged from
+// board_netlist_updater.cpp so the updater itself does not reference the editor frame. A
+// build without the editor supplies its own version of this file.
+
+#include "board_netlist_updater.h"
+
+#include <eda_units.h>
+#include <base_units.h>
+#include <pcb_draw_panel_gal.h>
+#include <pcb_edit_frame.h>
+#include <pcb_field.h>
+#include <pcbnew_settings.h>
+#include <view/view.h>
+
+
+namespace BOARD_NETLIST_UPDATER_FRAME
+{
+
+FOOTPRINT* LoadFootprint( PCB_EDIT_FRAME* aFrame, const LIB_ID& aFootprintId )
+{
+    return aFrame->LoadFootprint( aFootprintId );
+}
+
+
+void ExchangeFootprint( PCB_EDIT_FRAME* aFrame, FOOTPRINT* aExisting, FOOTPRINT* aNew, BOARD_COMMIT& aCommit )
+{
+    aFrame->ExchangeFootprint( aExisting, aNew, aCommit );
+}
+
+
+bool ShowGlobalRatsnest( PCB_EDIT_FRAME* aFrame )
+{
+    return aFrame->GetPcbNewSettings()->m_Display.m_ShowGlobalRatsnest;
+}
+
+
+void StyleField( PCB_EDIT_FRAME* aFrame, PCB_FIELD* aField )
+{
+    aField->StyleFromSettings( aFrame->GetDesignSettings(), true );
+}
+
+
+void RemoveFromView( PCB_EDIT_FRAME* aFrame, EDA_ITEM* aItem )
+{
+    aFrame->GetCanvas()->GetView()->Remove( aItem );
+}
+
+
+void OnModify( PCB_EDIT_FRAME* aFrame )
+{
+    aFrame->OnModify();
+}
+
+
+std::pair<wxString, wxString> PositionText( PCB_EDIT_FRAME* aFrame, VECTOR2I aPosition )
+{
+    if( aFrame && aFrame->GetPcbNewSettings() )
+    {
+        if( aFrame->GetPcbNewSettings()->m_Display.m_DisplayInvertXAxis )
+            aPosition.x *= -1;
+
+        if( aFrame->GetPcbNewSettings()->m_Display.m_DisplayInvertYAxis )
+            aPosition.y *= -1;
+    }
+
+    if( aFrame )
+        return { aFrame->MessageTextFromValue( aPosition.x ), aFrame->MessageTextFromValue( aPosition.y ) };
+
+    return { EDA_UNIT_UTILS::UI::MessageTextFromValue( pcbIUScale, EDA_UNITS::MM, aPosition.x ),
+             EDA_UNIT_UTILS::UI::MessageTextFromValue( pcbIUScale, EDA_UNITS::MM, aPosition.y ) };
+}
+
+} // namespace BOARD_NETLIST_UPDATER_FRAME
