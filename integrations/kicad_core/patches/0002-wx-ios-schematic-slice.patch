+#ifndef PG_CHOICES_FALLBACK_H
+#define PG_CHOICES_FALLBACK_H
+
+// The property system stores enum choices in wxPGChoices. wxWidgets ports without the
+// property grid (wxUSE_PROPGRID 0, such as iOS) do not declare it, so this provides the part
+// of its interface the property system uses, with the same semantics. Only included when
+// wxWidgets does not provide the real class.
+
+#include <wx/arrstr.h>
+#include <wx/dynarray.h>
+#include <wx/string.h>
+
+#include <limits>
+#include <utility>
+#include <vector>
+
+constexpr int wxPG_INVALID_VALUE = std::numeric_limits<int>::max();
+
+class wxPGChoices
+{
+public:
+    /// Values default to the entry's index, as in wxPGChoices.
+    void Add( const wxString& aLabel, int aValue = wxPG_INVALID_VALUE )
+    {
+        if( aValue == wxPG_INVALID_VALUE )
+            aValue = (int) m_items.size();
+
+        m_items.emplace_back( aLabel, aValue );
+    }
+
+    unsigned int GetCount() const { return (unsigned int) m_items.size(); }
+    bool         IsOk() const { return !m_items.empty(); }
+    void         Clear() { m_items.clear(); }
+
+    const wxString& GetLabel( unsigned int aIndex ) const { return m_items[aIndex].first; }
+    int             GetValue( unsigned int aIndex ) const { return m_items[aIndex].second; }
+
+    int Index( int aValue ) const
+    {
+        for( size_t i = 0; i < m_items.size(); i++ )
+        {
+            if( m_items[i].second == aValue )
+                return (int) i;
+        }
+
+        return -1;
+    }
+
+    int Index( const wxString& aLabel ) const
+    {
+        for( size_t i = 0; i < m_items.size(); i++ )
+        {
+            if( m_items[i].first == aLabel )
+                return (int) i;
+        }
+
+        return -1;
+    }
+
+    void RemoveAt( size_t aIndex, size_t aCount = 1 )
+    {
+        m_items.erase( m_items.begin() + aIndex, m_items.begin() + aIndex + aCount );
+    }
+
+    wxArrayString GetLabels() const
+    {
+        wxArrayString labels;
+
+        for( const auto& [label, value] : m_items )
+            labels.Add( label );
+
+        return labels;
+    }
+
+    /// Values for the labels in @a aStrings, in that order, with wxPG_INVALID_VALUE for an
+    /// unknown label; empty when there are no choices. Same as wxPGChoices.
+    wxArrayInt GetValuesForStrings( const wxArrayString& aStrings ) const
+    {
+        wxArrayInt values;
+
+        if( IsOk() )
+        {
+            for( const wxString& label : aStrings )
+            {
+                int index = Index( label );
+                values.Add( index >= 0 ? m_items[index].second : wxPG_INVALID_VALUE );
+            }
+        }
+
+        return values;
+    }
+
+private:
+    std::vector<std::pair<wxString, int>> m_items;
+};
+
+#endif // PG_CHOICES_FALLBACK_H
