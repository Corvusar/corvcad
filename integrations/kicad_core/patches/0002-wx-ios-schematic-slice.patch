-
-        if( rcItem->GetAuxItem3ID() != niluuid )
-            n->m_Children.push_back( createNode( n, rcItem, RC_TREE_NODE::AUX_ITEM3 ) );
-
-        if( MARKER_BASE* marker = rcItem->GetParent() )
-        {
-            if( marker->IsExcluded() && !marker->GetComment().IsEmpty() )
