CorvCAD patch series for KiCad 10.0.6 (caf7377), on top of 0002: build the Apple
KIPLATFORM environment layer for iOS.

Applied by integrations/kicad_core/fetch.py. macOS behaviour is unchanged.

1. libs/kiplatform/os/apple/environment.mm imports Foundation instead of Cocoa on iOS
   (TARGET_OS_IPHONE) and skips the NSWindow tabbing call there. Everything else in the file
   (trash, cache directory, CFNetwork proxy lookup) uses APIs iOS also provides.
diff --git a/libs/kiplatform/os/apple/environment.mm b/libs/kiplatform/os/apple/environment.mm
index d1bc1a1f..1539ca00 100644
--- a/libs/kiplatform/os/apple/environment.mm
+++ b/libs/kiplatform/os/apple/environment.mm
@@ -23,7 +23,13 @@
 #include <memory>
 #include <string>
 
+#include <TargetConditionals.h>
+
+#if TARGET_OS_IPHONE
+#import <Foundation/Foundation.h>
+#else
 #import <Cocoa/Cocoa.h>
+#endif
 #import <CFNetwork/CFNetwork.h>
 #include <wx/osx/core/cfstring.h>
 #include <wx/filefn.h>
@@ -33,8 +39,10 @@
 
 void KIPLATFORM::ENV::Init()
 {
+#if !TARGET_OS_IPHONE
     // Disable the automatic window tabbing OSX does
     [NSWindow setAllowsAutomaticWindowTabbing:NO];
+#endif
 
     // No tasks for this platform
 }
