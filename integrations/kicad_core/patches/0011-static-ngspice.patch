+    m_ngSpice_AllVecs = &::ngSpice_AllVecs;
+    m_ngSpice_Running = &::ngSpice_running;
+    m_ngSpice_LockRealloc = &::ngSpice_LockRealloc;
+    m_ngSpice_UnlockRealloc = &::ngSpice_UnlockRealloc;
