(kicad_pcb (version 20241229) (generator "corvcad_fixture")
(general (thickness 1.6))
(net 0 "")
(net 1 "/rect_out")
(net 2 "/signal_in")
(net 3 "GND")
(net 4 "Net-(D1-A)")
(gr_rect (start 5 5) (end 60 80) (stroke (width 0.1) (type default)) (fill no) (layer "Edge.Cuts"))
(footprint "Fixture:C1" (layer "F.Cu") (at 20 20) (property "Reference" "C1" (at 0 -3 0) (layer "F.SilkS")) (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "/rect_out")) (pad "2" thru_hole circle (at 10 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 3 "GND")))
(footprint "Fixture:D1" (layer "F.Cu") (at 20 30) (property "Reference" "D1" (at 0 -3 0) (layer "F.SilkS")) (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "/rect_out")) (pad "2" thru_hole circle (at 10 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 4 "Net-(D1-A)")))
(footprint "Fixture:R1" (layer "F.Cu") (at 20 40) (property "Reference" "R1" (at 0 -3 0) (layer "F.SilkS")) (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "/signal_in")) (pad "2" thru_hole circle (at 10 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 4 "Net-(D1-A)")))
(footprint "Fixture:R2" (layer "F.Cu") (at 20 50) (property "Reference" "R2" (at 0 -3 0) (layer "F.SilkS")) (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "/rect_out")) (pad "2" thru_hole circle (at 10 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 3 "GND")))
(footprint "Fixture:V1" (layer "F.Cu") (at 20 60) (property "Reference" "V1" (at 0 -3 0) (layer "F.SilkS")) (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "/signal_in")) (pad "2" thru_hole circle (at 10 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 3 "GND")))
(segment (start 20 20) (end 20 30) (width 0.5) (layer "F.Cu") (net 1))
(segment (start 20 30) (end 20 50) (width 0.5) (layer "F.Cu") (net 1))
(segment (start 20 40) (end 20 60) (width 0.5) (layer "F.Cu") (net 2))
(segment (start 30 20) (end 30 50) (width 0.5) (layer "F.Cu") (net 3))
(segment (start 30 50) (end 30 60) (width 0.5) (layer "F.Cu") (net 3))
(segment (start 30 30) (end 30 40) (width 0.5) (layer "F.Cu") (net 4))
)
